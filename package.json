{
  "name": "symbol-qr-library-esm",
  "version": "1.0.0",
  "description": "Symbol library to generate QR Code data (ESM version)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.10",
    "@types/crypto-js": "^4.2.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "rxjs": "^7.8.1",
    "symbol-hd-wallets": "^0.14.2",
    "symbol-sdk": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "pretest": "npm run build",
    "build": "rm -rf dist/ && tsc",
    "lint": "echo 'Linting placeholder - will add ESLint later'",
    "test": "mocha --ui bdd --recursive ./dist/test --loader=ts-node/esm",
    "test:cov": "nyc --reporter=lcov --reporter=text-summary npm test",
    "version": "echo $npm_package_version",
    "doc": "echo 'Documentation generation placeholder'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanchi4425/symbol-qr-library-esm.git"
  },
  "author": "Grégory Saive from Using Blockchain Ltd <greg@ubc.digital>, yanchi4425 (ESM migration)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/yanchi4425/symbol-qr-library-esm/issues"
  },
  "homepage": "https://github.com/yanchi4425/symbol-qr-library-esm#readme",
  "keywords": [
    "symbol",
    "qr-code",
    "blockchain",
    "esm",
    "typescript"
  ],
  "nyc": {
    "exclude": [
      "**/*.spec.js"
    ]
  }
}
