{
  "name": "symbol-qr-library-lite",
  "version": "1.0.0",
  "description": "Symbol library to generate QR Code data (Lite edition)",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.3",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "chai": "^5.2.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-promise": "^7.2.1",
    "mocha": "^11.7.1",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "rollup": "^4.44.1",
    "rollup-plugin-dts": "^6.2.1",
    "symbol-sdk": "~3.2.3",
    "ts-node": "^10.9.1",
    "tslib": "^2.8.1",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "pretest": "npm run build",
    "build": "rm -rf dist/ && rollup -c",
    "lint": "eslint src/ test/ --ext .ts",
    "lint:fix": "eslint src/ test/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{js,json,md}\"",
    "test": "mocha --ui bdd --recursive ./dist/test --loader=ts-node/esm",
    "test:cov": "nyc --reporter=lcov --reporter=text-summary npm test",
    "version": "echo $npm_package_version",
    "doc": "echo 'Documentation generation placeholder'",
    "tsc": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanchi4425/symbol-qr-library-esm.git"
  },
  "author": "Grégory Saive from Using Blockchain Ltd <greg@ubc.digital>, yanchi4425 (ESM migration)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/yanchi4425/symbol-qr-library-esm/issues"
  },
  "homepage": "https://github.com/yanchi4425/symbol-qr-library-esm#readme",
  "keywords": [
    "symbol",
    "qr-code",
    "blockchain",
    "esm",
    "typescript"
  ],
  "nyc": {
    "exclude": [
      "**/*.spec.js"
    ]
  }
}
